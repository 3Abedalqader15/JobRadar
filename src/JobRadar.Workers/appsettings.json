{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Hangfire": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/jobradar-workers-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{ThreadId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithThreadId",
      "WithMachineName",
      "WithEnvironmentName"
    ]
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=aws-1-eu-west-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.pzrxrjrqjitlqgxjhqyw;Password=152003AMAf@#;SSL Mode=Require;Trust Server Certificate=true;Maximum Pool Size=5;Minimum Pool Size=0;Connection Idle Lifetime=10;",
    "Hangfire": "Host=aws-1-eu-west-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.pzrxrjrqjitlqgxjhqyw;Password=152003AMAf@#;SSL Mode=Require;Trust Server Certificate=true;Search Path=hangfire;Maximum Pool Size=5;Minimum Pool Size=0;Connection Idle Lifetime=10;"
  },
  "Ingestion": {
    "FailureThreshold": 5,
    "DefaultFetchIntervalMinutes": 60
  },
  "Polly": {
    "RetryCount": 3,
    "BackoffSeconds": 2
  },
  "Telegram": {
    "ApiId": "",
    "ApiHash": "",
    "SessionPath": "telegram.session"
  },
  "JobCrawler": {
    "IntervalMinutes": 30
  },
  "Gemini": {
    "Model": "gemini-3.5-flash-lite",
    "ConfidenceThreshold": 0.70,
    "TimeoutSeconds": 120,
    "Temperature": 0.1,
    "CvMatch": {
      "ActivePromptVersion": "v2",
      "MinJobDescriptionLength": 300,
      "Weights": {
        "RequiredSkillsMatch": 40,
        "ExperienceLevelMatch": 25,
        "DomainRelevance": 20,
        "NiceToHaveSkillsMatch": 15
      }
    }
  }
}
